{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm install"
  },
  "deploy": {
    "startCommand": "node --experimental-sqlite server.js",
    "healthcheckPath": "/api/network-mode",
    "healthcheckTimeout": 100,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 3
  },
  "environments": {
    "production": {
      "NODE_VERSION": "22",
      "EDIT_PASSWORD": "campus2026"
    }
  }
}
